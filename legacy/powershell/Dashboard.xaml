<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Пульс ПК · Діагностика Windows" Width="1100" Height="800" MinWidth="760" MinHeight="580" Background="#0E151D" Foreground="#E5EEF4" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#DFEAF2"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#DEEBF4"/><Setter Property="Background" Value="#21313E"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Name="edge" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="#354854"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="#7BDBC0"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="edge" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#151F29"/><Setter Property="Foreground" Value="#DFEBF5"/><Setter Property="RowBackground" Value="#151F29"/><Setter Property="AlternatingRowBackground" Value="#192631"/><Setter Property="BorderThickness" Value="0"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="30"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserSortColumns" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#23333F"/><Setter Property="Foreground" Value="#B3C5D2"/><Setter Property="Padding" Value="6,7"/></Style>
 </Window.Resources>
 <Grid Margin="24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><StackPanel Orientation="Horizontal"><Border CornerRadius="8" Background="#25443F" Width="42" Height="42" Margin="0,0,12,0"><Polyline Points="6,23 13,23 17,13 22,31 26,20 36,20" Stroke="#78E1BF" StrokeThickness="2.5"/></Border><TextBlock Text="Пульс ПК" FontSize="29" FontWeight="SemiBold"/></StackPanel><TextBlock Name="machine" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#A7BAC8"/></DockPanel>
 <UniformGrid Name="cards" Grid.Row="1" Rows="1" Margin="0,18,0,12"/>
 <Border Grid.Row="2" Background="#151F29" CornerRadius="9" Padding="16,12"><StackPanel><DockPanel><TextBlock Name="graphTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock Name="scale" HorizontalAlignment="Right" Foreground="#A7BAC8"/></DockPanel><Canvas Name="plot" Background="#151F29" Height="90" ClipToBounds="True"/><DockPanel><TextBlock Text="−60 с" Foreground="#91A6B8"/><TextBlock Text="Зараз" HorizontalAlignment="Right" Foreground="#91A6B8"/></DockPanel></StackPanel></Border>
 <DockPanel Grid.Row="3" Margin="0,15,0,9"><StackPanel Orientation="Horizontal"><Button Name="processTab">Процеси</Button><Button Name="eventTab">Запуски й вимкнення</Button></StackPanel><StackPanel Name="searchPanel" HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock Text="Назва або PID" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="search" Width="145" VerticalContentAlignment="Center" Padding="7,3" Background="#192530" Foreground="White" CaretBrush="White" BorderBrush="#405260" AutomationProperties.Name="Пошук процесу"/></StackPanel></DockPanel>
 <DataGrid Grid.Row="4" Name="processGrid"><DataGrid.Columns><DataGridTextColumn Header="Процес" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="Пам’ять, МіБ ↓" Binding="{Binding Memory}" Width="*"/><DataGridTextColumn Header="Час запуску" Binding="{Binding Started,StringFormat={}{0:dd.MM.yyyy HH:mm:ss},TargetNullValue=—}" Width="1.4*"/></DataGrid.Columns></DataGrid>
 <DataGrid Grid.Row="4" Name="eventGrid" Visibility="Collapsed"><DataGrid.Columns><DataGridTextColumn Header="Час запису" Binding="{Binding Time,StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="1.4*"/><DataGridTextColumn Header="Подія Windows" Binding="{Binding Event}" Width="3*"/><DataGridTextColumn Header="Код" Binding="{Binding Id}" Width="0.6*"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="5" Name="status" Margin="0,9,0,0" Foreground="#A7BAC8" TextWrapping="Wrap"/>
 </Grid>
</Window>
